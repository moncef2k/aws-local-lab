# Copy to .env (gitignored) and adjust: cp .env.example .env
# Only fake / local values here. Never put real credentials in this project.

# Prefix for container, network and volume names
COMPOSE_PROJECT_NAME=aws-local-lab

# API (Lab 01)
API_LOG_LEVEL=info

# Load balancer (Lab 02): the one published port, on 127.0.0.1 only
LB_HOST_PORT=80

# Database (Lab 04). Fake local values. POSTGRES_PASSWORD has no default: put your own in .env.
# Note: Postgres only reads these when it creates an empty data volume; changing the password
# later in .env does not change the one stored in an existing volume.
POSTGRES_USER=lab
POSTGRES_DB=lab
POSTGRES_PASSWORD=change-me-local-only
# Cache (Lab 05). Fake local value. REDIS_PASSWORD has no default: put your own in .env.
REDIS_PASSWORD=change-me-local-only
# Lab 05, step 16: seconds a cached note stays valid (optional, 60 if unset).
# CACHE_TTL_SECONDS=60

# Object storage (Lab 06). Fake local values, no defaults: put your own in .env.
# S3_ACCESS_KEY is like an AWS access key id, S3_SECRET_KEY like its secret.
S3_ACCESS_KEY=change-me-local-access-key
S3_SECRET_KEY=change-me-local-only-secret
# Name of the bucket created at start-up (optional, "uploads" if unset)
# S3_BUCKET=uploads

# Admin access (Lab 04, step 13): host port of "docker compose --profile admin up -d db-proxy"
ADMIN_DB_PORT=5432
